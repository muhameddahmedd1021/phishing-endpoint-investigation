<dashboard version="1.1" theme="dark">
  <label>Phishing to Endpoint Investigation</label>
  <description>MOHAMEDAHMED | UTC</description>
  <row>
    <panel>
      <title>SMTP deliveries</title>
      <single>
        <search>
          <query>index=lab_phishing sourcetype="soc:smtp:delivery" | stats count</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">0</option>
        <option name="showTrendIndicator">0</option>
        <option name="useColors">1</option>
        <option name="colorMode">none</option>
        <option name="rangeColors">["0x53a051"]</option>
        <option name="rangeValues">[]</option>
      </single>
    </panel>
    <panel>
      <title>Recipient addresses</title>
      <single>
        <search>
          <query>index=lab_phishing sourcetype="soc:smtp:delivery" | stats dc(recipient) as count</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">0</option>
        <option name="showTrendIndicator">0</option>
        <option name="useColors">1</option>
        <option name="colorMode">none</option>
        <option name="rangeColors">["0x53a051"]</option>
        <option name="rangeValues">[]</option>
      </single>
    </panel>
    <panel>
      <title>Endpoint process launches</title>
      <single>
        <search>
          <query>index=lab_phishing provider="Microsoft-Windows-Sysmon" event_id=1 | stats count</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">0</option>
        <option name="showTrendIndicator">0</option>
        <option name="useColors">1</option>
        <option name="colorMode">none</option>
        <option name="rangeColors">["0x53a051"]</option>
        <option name="rangeValues">[]</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Actual SMTP delivery records</title>
      <table>
        <search>
          <query>index=lab_phishing sourcetype="soc:smtp:delivery" | eval UTC=substr(utc,12,12) | table UTC recipient mail_from subject</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="count">12</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Endpoint execution chain</title>
      <table>
        <search>
          <query>index=lab_phishing provider="Microsoft-Windows-Sysmon" event_id=1 | eval UTC=substr(utc,12,12),PID='data.ProcessId',ParentPID='data.ParentProcessId',Command=substr('data.CommandLine',1,170) | table UTC PID ParentPID Command | sort 0 UTC</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="count">12</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</dashboard>
